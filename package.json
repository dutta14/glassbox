{
  "name": "glassbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "DEPLOY_TARGET=pages npm run build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc -b",
    "lint": "oxlint --max-warnings 30",
    "format": "prettier --write src e2e .storybook .github \"*.ts\"",
    "format:check": "prettier --check src e2e .storybook .github \"*.ts\"",
    "audit": "npm audit --audit-level=high",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "storybook": "^10.6.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "undici": "^7.30.2",
    "source-map-js": "^1.2.2"
  }
}
